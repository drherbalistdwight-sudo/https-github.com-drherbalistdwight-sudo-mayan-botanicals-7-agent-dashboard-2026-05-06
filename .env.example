# GoHighLevel integration (recommended: inbound webhook trigger URL)
GHL_INBOUND_WEBHOOK_URL=
GHL_WEBHOOK_BEARER_TOKEN=

# Optional direct GoHighLevel API mode (for contact upsert + note)
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_API_TOKEN=
GHL_API_VERSION=2021-07-28
GHL_LOCATION_ID=

# Retell AI integration
RETELL_API_BASE=https://api.retellai.com
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=
