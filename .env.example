# Server settings
HOST=127.0.0.1
PORT=8080
PUBLIC_APP_URL=https://ops.mayanbotanicals.com

# Claude runtime
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_ENDPOINT=https://api.anthropic.com/v1/messages

# Optional webhook mode (used only when CLAUDE_API_KEY is empty)
